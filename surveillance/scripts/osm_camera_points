#!/usr/bin/env python3
"""Convert osmium-exported GeoJSON sequence to camera points for Tippecanoe."""
import json
import sys

def points(coords):
    if isinstance(coords, list):
        if len(coords) >= 2 and all(isinstance(v, (int, float)) for v in coords[:2]):
            yield coords[:2]
        else:
            for item in coords:
                yield from points(item)

count = 0
with open(sys.argv[1], encoding="utf-8") as source, open(sys.argv[2], "w", encoding="utf-8") as target:
    for line in source:
        if not line.strip():
            continue
        feature = json.loads(line.strip().lstrip("\x1e"))
        geometry = feature.get("geometry") or {}
        coords = list(points(geometry.get("coordinates", [])))
        if not coords:
            continue
        if geometry.get("type") == "Point":
            location = coords[0]
        else:
            location = [sum(c[i] for c in coords) / len(coords) for i in (0, 1)]
        props = feature.get("properties") or {}
        props["source"] = "OSM"
        # Specific camera tags take precedence over generic surveillance tags.
        # An untagged highway=traffic_signals alone is NOT a red-light camera.
        if (props.get("highway") == "red_light_camera" or
                props.get("surveillance") == "red_light" or
                props.get("enforcement") == "traffic_signals"):
            camera_type, title = "red_light", "Red-light enforcement camera"
        elif (props.get("highway") == "speed_camera" or
                props.get("enforcement") in ("maxspeed", "average_speed")):
            camera_type, title = "speed", "Speed enforcement camera"
        else:
            camera_type, title = "surveillance", "OSM surveillance camera"
        props["camera_type"] = camera_type
        props["camera_title"] = title
        feature["geometry"] = {"type": "Point", "coordinates": location}
        feature["properties"] = props
        target.write(json.dumps(feature, separators=(",", ":")) + "\n")
        count += 1
print(f"Exported {count} OSM camera features")
