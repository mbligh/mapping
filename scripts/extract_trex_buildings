#!/usr/bin/env bash
# Decode the highest-detail T.REX NJ building footprint layer to GeoJSON.
# Usage: scripts/extract_trex_buildings nj_features.pmtiles [output.geojson.gz]
set -euo pipefail
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "Usage: $0 input.pmtiles [output.geojson.gz]" >&2
  exit 2
fi
command -v tippecanoe-decode >/dev/null 2>&1 || {
  echo "tippecanoe-decode is required (from tippecanoe, not go-pmtiles)" >&2
  exit 1
}
input=$1
output=${2:-nj_buildings.geojson.gz}
[ -f "$input" ] || { echo "Missing archive: $input" >&2; exit 1; }
tmp="${output}.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
# Limit to the highest available zoom level. The NJ extract was made at z13.
# Lower zooms would duplicate and simplify the same features.
tippecanoe-decode -Z 13 -z 13 -c -l buildings "$input" | python3 scripts/flatten_trex_buildings "${output%.geojson.gz}.summary.json" | gzip -n -c > "$tmp"
gzip -t "$tmp"
[ -s "$tmp" ] || { echo "Empty buildings output" >&2; exit 1; }
mv "$tmp" "$output"
echo "Wrote $output"
